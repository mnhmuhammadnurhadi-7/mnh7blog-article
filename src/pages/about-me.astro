---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="About Me"
  description="Tentang Muhammad Nur Hadi, project coordinator, system analyst, dan SEO specialist yang membangun produk digital terstruktur dan mudah ditemukan di hasil pencarian."
>
  <section class="about-hero">
    <p class="meta-strip">About Me</p>
    <h1>Muhammad Nur Hadi</h1>
    <p class="hero-subtitle">Project Coordinator, System Analyst, & SEO Specialist</p>
  </section>

  <section class="section-section">
    <div class="about-bio">
      <h2>Tentang Saya</h2>
      <p>
        Saya adalah seorang <strong>Project Coordinator</strong>, <strong>System Analyst</strong>, dan <strong>SEO Specialist</strong> yang berdedikasi untuk membangun produk digital terstruktur, efisien, dan mudah ditemukan di hasil pencarian. Dengan kombinasi keahlian teknis dalam analisis sistem dan strategi optimasi mesin pencari, saya membantu bisnis menjembatani kebutuhan teknis dengan visibilitas maksimal di internet.
      </p>
      <p>
        Berbasis di Malang, Jawa Timur, Indonesia, saya selalu tertarik pada pengembangan alur kerja sistem yang rapi, dokumentasi proses bisnis yang jelas, serta penulisan konten berkualitas tinggi yang mampu bersaing di halaman pertama Google.
      </p>
    </div>
  </section>

  <section class="section-section">
    <h2 class="section-title">Skills & Capabilities</h2>
    <div class="skills-grid">
      <div class="skill-card">
        <h3>Project & Coordination</h3>
        <div class="skill-tags">
          <span class="skill-tag">Project Management</span>
          <span class="skill-tag">System Flow Design</span>
          <span class="skill-tag">Cross-team Leadership</span>
          <span class="skill-tag">Stakeholder Reporting</span>
          <span class="skill-tag">Task Delegation</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>System Analysis</h3>
        <div class="skill-tags">
          <span class="skill-tag">Workflow Design</span>
          <span class="skill-tag">Process Documentation</span>
          <span class="skill-tag">Architecture Planning</span>
          <span class="skill-tag">Requirements Analysis</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>SEO & Content</h3>
        <div class="skill-tags">
          <span class="skill-tag">SEO Writing</span>
          <span class="skill-tag">Keyword Research</span>
          <span class="skill-tag">Google Page 1 Ranking</span>
          <span class="skill-tag">Article Publishing</span>
          <span class="skill-tag">Content Strategy</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>Technical</h3>
        <div class="skill-tags">
          <span class="skill-tag">React</span>
          <span class="skill-tag">Laravel</span>
          <span class="skill-tag">MySQL</span>
          <span class="skill-tag">Figma</span>
          <span class="skill-tag">REST API</span>
          <span class="skill-tag">CMS</span>
          <span class="skill-tag">n8n</span>
          <span class="skill-tag">Ollama</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>Deployment & Tools</h3>
        <div class="skill-tags">
          <span class="skill-tag">Vercel</span>
          <span class="skill-tag">Northflank</span>
          <span class="skill-tag">Aiven</span>
          <span class="skill-tag">Git</span>
          <span class="skill-tag">Google Workspace</span>
          <span class="skill-tag">Microsoft Office</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>Languages</h3>
        <div class="skill-tags">
          <span class="skill-tag">Indonesian (Native)</span>
          <span class="skill-tag">English (Intermediate)</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-section">
    <h2 class="section-title">Contact Me</h2>
    <div class="contact-grid">
      <a href="https://wa.me/628xxxxxxxxx" target="_blank" rel="noopener noreferrer" class="contact-card whatsapp">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div class="contact-info">
          <h3>WhatsApp</h3>
          <p>Hubungi via WhatsApp</p>
        </div>
      </a>
      
      <a href="https://linkedin.com/in/username" target="_blank" rel="noopener noreferrer" class="contact-card linkedin">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </div>
        <div class="contact-info">
          <h3>LinkedIn</h3>
          <p>Terhubung secara profesional</p>
        </div>
      </a>

      <a href="https://mnurhadi-porto.vercel.app" target="_blank" rel="noopener noreferrer" class="contact-card portfolio">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </div>
        <div class="contact-info">
          <h3>Portfolio</h3>
          <p>Kunjungi website portfolio</p>
        </div>
      </a>

      <a href="https://github.com/mnhmuhammadnurhadi-7" target="_blank" rel="noopener noreferrer" class="contact-card github">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
        </div>
        <div class="contact-info">
          <h3>GitHub</h3>
          <p>Lihat proyek repositori</p>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding: 6rem 1.5rem 2rem; /* pt-24 px-6 pb-8 */
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .about-hero {
      padding: 6rem 2.5rem 2rem; /* pt-24 md:px-10 pb-8 */
    }
  }

  .meta-strip {
    font-size: 0.75rem; /* text-xs */
    font-weight: 700; /* font-bold */
    letter-spacing: 0.2em; /* tracking-[0.2em] */
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
  }

  .about-hero h1 {
    font-family: 'Sora', sans-serif;
    font-size: 2.25rem; /* text-4xl */
    font-weight: 800; /* font-extrabold */
    letter-spacing: -0.025em; /* tracking-tight */
    margin: 0;
    color: var(--text-primary);
  }

  @media (min-width: 768px) {
    .about-hero h1 {
      font-size: 3rem; /* md:text-5xl */
    }
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .section-section {
    padding: 0 1.5rem; /* px-6 */
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .section-section {
      padding: 0 2.5rem; /* md:px-10 */
    }
  }

  .about-bio {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 2rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .about-bio h2 {
    font-family: 'Sora', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .section-title {
    font-family: 'Sora', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem; /* gap-6 */
  }

  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr); /* md:grid-cols-2 */
    }
  }

  @media (min-width: 1024px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr); /* lg:grid-cols-3 */
    }
  }

  .skill-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 1rem; /* rounded-2xl */
    padding: 1.75rem; /* p-7 */
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .skill-card:hover {
    transform: translateY(-4px) scale(1.03);
    border-color: #3b82f6; /* hover:border-blue-400/50 */
  }

  .skill-card h3 {
    font-size: 0.875rem; /* text-sm */
    font-weight: 900; /* font-black */
    letter-spacing: 0.05em; /* tracking-wide */
    margin-bottom: 1.25rem; /* mb-5 */
    color: var(--text-primary);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem; /* gap-2 */
  }

  .skill-tag {
    background: linear-gradient(to right, rgba(59, 130, 246, 0.2), rgba(16, 185, 129, 0.2)); /* bg-gradient-to-r from-blue-500/20 to-emerald-500/20 */
    color: var(--text-secondary);
    font-size: 0.75rem; /* text-xs */
    font-weight: 500; /* font-medium */
    padding: 0.375rem 0.75rem; /* px-3 py-1.5 */
    border-radius: 9999px;
    border: 1px solid var(--border-color);
    transition: border-color 0.3s ease;
  }

  .skill-tag:hover {
    border-color: rgba(59, 130, 246, 0.5); /* hover:border-blue-400/50 */
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 1.25rem;
    text-decoration: none;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .contact-card:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: linear-gradient(to right, rgba(59, 130, 246, 0.1), rgba(16, 185, 129, 0.1));
    color: var(--accent-1);
    flex-shrink: 0;
    transition: color 0.3s ease, background 0.3s ease;
  }

  .contact-info h3 {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.125rem 0;
    color: var(--text-primary);
  }

  .contact-info p {
    font-size: 0.75rem;
    margin: 0;
    color: var(--text-muted);
  }

  /* Hover behaviors for individual cards */
  .contact-card.whatsapp:hover {
    border-color: #25d366;
  }
  .contact-card.whatsapp:hover .contact-icon {
    color: #25d366;
    background: rgba(37, 211, 102, 0.1);
  }

  .contact-card.linkedin:hover {
    border-color: #0077b5;
  }
  .contact-card.linkedin:hover .contact-icon {
    color: #0077b5;
    background: rgba(0, 119, 181, 0.1);
  }

  .contact-card.portfolio:hover {
    border-color: var(--accent-3);
  }
  .contact-card.portfolio:hover .contact-icon {
    color: var(--accent-3);
    background: rgba(139, 92, 246, 0.1);
  }

  .contact-card.github:hover {
    border-color: var(--text-primary);
  }
  .contact-card.github:hover .contact-icon {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.1);
  }
</style>
